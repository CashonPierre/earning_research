# Copy this file to .env and fill in your own key. .env is git-ignored.
MASSIVE_API_KEY=
# Set to 0 only if you knowingly accept the risk; the brief requires all API usage from a Hong Kong IP with no VPN.
REQUIRE_HK_IP=1
# SEC EDGAR requires a descriptive User-Agent with a contact address
EDGAR_USER_AGENT=Your Name your@email.example
